%---------------------------------%Cells%---------------------------------%
Type: Input
%-------------------------------------------------------------------------%
micSampleRate = dev["SampleRate"];
FrequencyAxis[n_, nTake_] := N@Range[0, nTake - 1] (micSampleRate/n)
ClearAll[findPeaks, FreqToNote];
findPeaks[spectrum_List, freqAxis_List, threshold_: Automatic] :=
 With[{peakPositions = FindPeaks[spectrum, Automatic, Automatic, threshold]},
  If[peakPositions === {},
   {10., 0.},
   First@MaximalBy[
     Map[Function[q, {freqAxis[[q[[1]]]], q[[2]]}], peakPositions],
     Last]
   ]
  ]

noteNames = {"C", "C#", "D", "D#", "E", "F", "F#", "G", "G#", "A", "A#", "B"};

FreqToNote[freq_] := FreqToNote[10.0];
FreqToNote[freq_?NumberQ] := Module[{midi, noteIdx, octave, cents},
  midi = 69 + 12*Log2[Max[freq, 10.]/440.];
  noteIdx = Mod[Round[midi], 12] + 1;
  octave = Quotient[Round[midi], 12] - 1;
  cents = Round[(midi - Round[midi])*100];
  <|"Note" -> noteNames[[noteIdx]] <> ToString[octave],
    "Cents" -> cents,
    "Frequency" -> freq|>
  ]

%-------------------------------------------------------------------------%
Type: Input
%-------------------------------------------------------------------------%
69 - 12 Log2[200/440.]

%-------------------------------------------------------------------------%
Type: Output
%-------------------------------------------------------------------------%
82.65004228499922`

%-------------------------------------------------------------------------%
Type: Input
%-------------------------------------------------------------------------%
FreqToNote[0.01]

%-------------------------------------------------------------------------%
Type: Output
%-------------------------------------------------------------------------%
<|"Note"->"E-11","Cents"->-10,"Frequency"->0.01`|>

%-------------------------------------------------------------------------%
Type: Input
%-------------------------------------------------------------------------%
DeviceExecute[dev, "ClearBuffer"];

%-------------------------------------------------------------------------%
Type: Input
%-------------------------------------------------------------------------%
windowLength =  3 1024;
buffer = Table[0., {windowLength}];
window = Array[HammingWindow, windowLength, {-1/2, 1/2}];

DeviceExecute[dev, "ClearBuffer"];
With[{xAxis = FrequencyAxis[windowLength,500]}, Refresh[
  If[dev["AvailableFrames"] >= windowLength,
    buffer = Take[DeviceReadBuffer[dev][[All,1]]//Normal,-windowLength];
  ];
  With[{spectrum = Clip[Take[Abs@Fourier[window buffer], 500], {0,1.9}]},
    Graphics[Line@Transpose[{xAxis, spectrum}], Axes->True, PlotRange->{{0,1500}, {0,2.0}}]
  ], 1/60.0]
]

%-------------------------------------------------------------------------%
Type: Input
%-------------------------------------------------------------------------%
windowLength =  3 1024;
buffer = Table[0., {windowLength}];
window = Array[HammingWindow, windowLength, {-1/2, 1/2}];

DeviceExecute[dev, "ClearBuffer"];
With[{xAxis = FrequencyAxis[windowLength,500]}, Refresh[
  If[dev["AvailableFrames"] >= windowLength,
    buffer = Take[DeviceReadBuffer[dev][[All,1]]//Normal,-windowLength];
  ];
  With[{spectrum = Clip[Take[Abs@Fourier[window buffer], 500], {0,1.0}]}, {
    peak = findPeaks[spectrum, xAxis]
  }, {
    note = FreqToNote[peak[[1]]]
  },

    Graphics[{
      Line@Transpose[{xAxis, spectrum}],
      Red, Translate[Text[note["Note"], peak, {0,0}], Offset[{0,-15}]]
    }, Axes->True, PlotRange->{{0,1500}, {0,1.2}}]
  ], 1/60.0]
]

